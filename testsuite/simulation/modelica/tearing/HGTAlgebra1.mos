// name:      HGTAlgebra1
// keywords:  tearing, hand guided tearing
// status:    correct
//
// Level 1 hand guided tearing of pure algebraic loops: a circle/hyperbola system
// with 4 roots where the pairs and start values select the root, and an inverse
// problem (a design spec paired with a bounded iteration variable)
// with an inner loop that needs an automatically added iteration variable.
//

loadFile("HGTAlgebra.mo"); getErrorString();
setCommandLineOptions("--handGuidedTearing -d=hgtDump"); getErrorString();
r := simulate(HGTAlgebra.System, stopTime = 0); getErrorString();
val(x, 0); val(y, 0); val(v, 0); val(z, 0); val(k, 0);

