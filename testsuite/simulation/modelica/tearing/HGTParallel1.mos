// name:      HGTParallel1
// keywords:  tearing, hand guided tearing
// status:    correct
//
// Three nested levels in a component array: the pump speed (level 1) is
// adjusted to the required total flow, the common pressure drop (level 2) to
// the pump head, and the flow of each of the 12 parallel branches (level 3) to
// the pressure drop. The pairs of the array elements differ only in their
// subscripts, and the level 2 block contains 12 independent level 3 blocks
// with one residual equation each.
//

loadFile("HGTParallel.mo"); getErrorString();
setCommandLineOptions("--handGuidedTearing -d=hgtDump"); getErrorString();
r := simulate(HGTParallel.Plant, stopTime = 0); getErrorString();
val(speed, 0); val(dp, 0); val(totalFlow, 0); val(branch[1].m, 0); val(branch[12].m, 0);
val(mixedTemperature, 0); val(heatDuty, 0);

