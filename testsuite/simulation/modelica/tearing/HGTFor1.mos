// name:      HGTFor1
// keywords:  tearing, hand guided tearing
// status:    correct
//
// Hand guided tearing pairs written in a for-loop are the same as the pairs
// written out for each iteration: same blocks, same result.
//

loadFile("HGT.mo"); getErrorString();
setCommandLineOptions("--handGuidedTearing --hgtOnly -d=hgtDump"); getErrorString();
r := simulate(HGT.ForPipe, stopTime = 0); getErrorString();
r := simulate(HGT.ForPipeScalar, stopTime = 0); getErrorString();
diffSimulationResults("HGT.ForPipe_res.mat", "HGT.ForPipeScalar_res.mat", "HGT.ForPipe_diff", relTol = 1e-10);
val(m, 0, "HGT.ForPipe_res.mat"); val(p[3], 0, "HGT.ForPipe_res.mat");

