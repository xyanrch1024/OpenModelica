// name:      HGTParallel1
// keywords:  tearing, hand guided tearing
// status:    correct
//
// A component array of 12 parallel branches: the pump speed is adjusted to the
// required total flow, the common pressure drop to the pump head, and the flow
// of each branch to the pressure drop, all in one block of 14 pairs. The pairs
// of the array elements differ only in their subscripts.
//

loadFile("HGTParallel.mo"); getErrorString();
setCommandLineOptions("--handGuidedTearing -d=hgtDump"); getErrorString();
r := simulate(HGTParallel.Plant, stopTime = 0); getErrorString();
val(speed, 0); val(dp, 0); val(totalFlow, 0); val(branch[1].m, 0); val(branch[12].m, 0);
val(mixedTemperature, 0); val(heatDuty, 0);

