// name:      HGTPair1
// keywords:  tearing, hand guided tearing
// status:    correct
//
// Hand guided tearing pairs: cross block pair and residual nominal.
//

loadFile("HGT.mo"); getErrorString();
setCommandLineOptions("--handGuidedTearing -d=hgtDump"); getErrorString();
simulate(HGT.CrossSCC); getErrorString();
val(v, 1.0); val(w, 1.0);
simulate(HGT.Loop); getErrorString();
val(x, 1.0); val(y, 1.0); val(z, 1.0);

