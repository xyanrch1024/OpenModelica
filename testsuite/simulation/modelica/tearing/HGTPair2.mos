loadFile("HGT.mo"); getErrorString();
setCommandLineOptions("--handGuidedTearing -d=hgtDump"); getErrorString();
simulate(HGT.Single); getErrorString();
val(x, 1.0);
simulate(HGT.Simple); getErrorString();
val(a, 1.0); val(b, 1.0);

