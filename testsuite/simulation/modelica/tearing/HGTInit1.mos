// name:      HGTInit1
// keywords:  tearing, hand guided tearing
// status:    correct
//
// A pair on an initial equation is used by the initialization system only, the
// simulation system has neither its residual equation nor an iteration variable.
//

loadFile("HGT.mo"); getErrorString();
setCommandLineOptions("--handGuidedTearing -d=hgtDump"); getErrorString();
r := simulate(HGT.InitialPair, stopTime = 1); getErrorString();
val(x, 0); val(x, 1);

