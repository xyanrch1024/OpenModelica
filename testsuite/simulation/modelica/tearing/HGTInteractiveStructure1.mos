// name:      HGTInteractiveStructure1
// keywords:  tearing, hand guided tearing, interactive FMU
// status:    correct
// teardown_command: rm -rf OuterSingular.fmu OuterSingular.log TwoBlocks.fmu TwoBlocks.log
//
// --interactiveFMU: structural checks at compile time, with all hold attributes
// false. Error 8026 names the equations and variables that have to become
// residual equations and iteration variables; warning 8027 the residual
// equations that can not determine the iteration variables.
//

loadFile("HGTInteractive.mo"); getErrorString();
setCommandLineOptions("--handGuidedTearing --interactiveFMU"); getErrorString();
buildModelFMU(HGTInteractive.MissingPair, version = "2.0", fmuType = "me"); getErrorString();
buildModelFMU(HGTInteractive.WrongVariable, version = "2.0", fmuType = "me"); getErrorString();
buildModelFMU(HGTInteractive.OuterSingular, version = "2.0", fmuType = "me"); getErrorString();
buildModelFMU(HGTInteractive.TwoBlocks, version = "2.0", fmuType = "me"); getErrorString();

