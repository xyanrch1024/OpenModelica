// name:      HGTArray1
// keywords:  tearing, hand guided tearing
// status:    correct
//
// An array residual equation paired element-wise with a slice of an array
// variable is the same as the pairs written in a for-loop. A matrix equation
// is paired element by element (each element is a block of its own, so a
// wrong element order would be reported as an independent residual).
//

loadFile("HGT.mo"); getErrorString();
setCommandLineOptions("--handGuidedTearing --hgtOnly -d=hgtDump"); getErrorString();
r := simulate(HGT.ArrayPipe, stopTime = 0); getErrorString();
r := simulate(HGT.ArrayPipeLoop, stopTime = 0); getErrorString();
diffSimulationResults("HGT.ArrayPipe_res.mat", "HGT.ArrayPipeLoop_res.mat", "HGT.ArrayPipe_diff", relTol = 1e-10);
val(m[1], 0, "HGT.ArrayPipe_res.mat"); val(p[4], 0, "HGT.ArrayPipe_res.mat");
r := simulate(HGT.MatrixPair, stopTime = 0); getErrorString();
val(x[1, 3], 0); val(x[2, 1], 0);

