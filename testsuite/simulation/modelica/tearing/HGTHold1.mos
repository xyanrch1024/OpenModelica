// name:      HGTHold1
// keywords:  tearing, hand guided tearing
// status:    correct
//
// hold keeps the iteration variable of a pair at its start value and drops the
// residual equation. It is a runtime switch: the residual equation becomes
// 0 = if hold then x - $START.x else residual, so -override changes it without
// recompiling, and so does the held value if the start value is a parameter.
//

loadFile("HGT.mo"); getErrorString();
setCommandLineOptions("--handGuidedTearing -d=nfScalarize"); getErrorString();

r := simulate(HGT.Hold, stopTime = 0); getErrorString();
{val(x, 0), val(y, 0)};
r := simulate(HGT.Hold, stopTime = 0, simflags = "-override=h=true"); getErrorString();
{val(x, 0), val(y, 0)};
r := simulate(HGT.Hold, stopTime = 0, simflags = "-override=h=true,x0=2.5"); getErrorString();
{val(x, 0), val(y, 0)};

r := simulate(HGT.HoldSingle, stopTime = 0); getErrorString();
val(x, 0);
r := simulate(HGT.HoldSingle, stopTime = 0, simflags = "-override=h=true"); getErrorString();
val(x, 0);

r := simulate(HGT.HoldArray, stopTime = 0); getErrorString();
{val(x[1], 0), val(x[2], 0), val(x[3], 0)};
r := simulate(HGT.HoldArray, stopTime = 0, simflags = "-override=h=true"); getErrorString();
{val(x[1], 0), val(x[2], 0), val(x[3], 0)};

