// name:      HGTLevel2
// keywords:  tearing, hand guided tearing
// status:    correct
//
// Three levels of nested hand guided tearing: each level is solved in a non-linear
// system within the residual function of the level above.
//

loadFile("HGT.mo"); getErrorString();
setCommandLineOptions("--handGuidedTearing -d=hgtDump,tearingdump"); getErrorString();
simulate(HGT.ThreeLevels, stopTime = 0); getErrorString();
val(y1, 0); val(y2, 0); val(y3, 0); val(a, 0);

