// name:      HGTBounds1
// keywords:  tearing, hand guided tearing
// status:    correct
//
// min/max of hand guided tearing iteration variables keep the Newton iterates
// within bounds (without them the start value y = 4 gives log(-34)), and the
// R9 check of --hgtAllowMultipleResiduals. Both models are time-independent,
// so their hand guided tearing blocks are only solved during initialization.
//

loadFile("HGT.mo"); getErrorString();
setCommandLineOptions("--handGuidedTearing"); getErrorString();
r := simulate(HGT.Bound, stopTime = 0); getErrorString();
val(y, 0); val(x, 0);

r := simulate(HGT.Multi, stopTime = 0); getErrorString();
val(x, 0); val(y, 0);
setCommandLineOptions("--hgtAllowMultipleResiduals=false"); getErrorString();
buildModel(HGT.Multi); getErrorString();

