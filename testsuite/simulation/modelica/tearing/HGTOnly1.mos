// name:      HGTOnly1
// keywords:  tearing, hand guided tearing
// status:    correct
//
// --hgtOnly tears the hand guided tearing blocks only with the given items: a
// block that needs an additional iteration variable or residual equation is an
// error. Without --hgtOnly the same models are torn automatically.
//

loadFile("HGT.mo"); getErrorString();
setCommandLineOptions("--handGuidedTearing --hgtOnly"); getErrorString();
r := simulate(HGT.OnlySolvable, stopTime = 0); getErrorString();
val(x, 0);
r := simulate(HGT.OnlyStuck, stopTime = 0); getErrorString();
r := simulate(HGT.OnlyUnmatched, stopTime = 0); getErrorString();

setCommandLineOptions("--hgtOnly=false"); getErrorString();
r := simulate(HGT.OnlyStuck, stopTime = 0); getErrorString();
val(x, 0);
r := simulate(HGT.OnlyUnmatched, stopTime = 0); getErrorString();
val(a, 0);

