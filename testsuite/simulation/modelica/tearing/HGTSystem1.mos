// name:      HGTSystem1
// keywords:  tearing, hand guided tearing
// status:    correct
//
// System level tearing pairs, also across two components.
//

loadFile("HGT.mo"); getErrorString();
setCommandLineOptions("--handGuidedTearing -d=hgtDump"); getErrorString();
simulate(HGT.SystemPair); getErrorString();
val(b.x, 1.0); val(b.y, 1.0);
simulate(HGT.CrossComponentPair); getErrorString();
val(splitter.factor, 1.0); val(mixer.y, 1.0);

