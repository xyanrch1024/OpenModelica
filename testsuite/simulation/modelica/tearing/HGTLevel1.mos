// name:      HGTLevel1
// keywords:  tearing, hand guided tearing
// status:    correct
//
// Nested levels are torn as level 1, and a model with states gives a warning.
//

loadFile("HGT.mo"); getErrorString();
setCommandLineOptions("--handGuidedTearing -d=hgtDump"); getErrorString();
// The Newton iterations of this example produce nan values on the way, only
// check that the simulation succeeds and the solution.
echo(false); r := simulate(HGT.NonConvex, stopTime = 0); echo(true);
r.resultFile <> ""; getErrorString();
val(x1, 0.0); val(x2, 0.0);
simulate(HGT.WithStates); getErrorString();
val(x, 1.0); val(z, 1.0);

