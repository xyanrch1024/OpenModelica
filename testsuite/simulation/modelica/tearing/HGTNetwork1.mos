// name:      HGTNetwork1
// keywords:  tearing, hand guided tearing
// status:    correct
//
// Level 1 hand guided tearing of a pump network: component and system level
// pairs, an unpaired residual equation (design spec) and iteration variable
// (valve opening) bound together, min/max bounds and a residual nominal. With
// m_set = 8 the design spec needs an opening u > 1: the bounded Newton solver
// fails and the solution of the fallback solver is rejected.
//

loadFile("HGTNetwork.mo"); getErrorString();
setCommandLineOptions("--handGuidedTearing -d=hgtDump"); getErrorString();
r := simulate(HGTNetwork.System, stopTime = 0); getErrorString();
val(p_m, 0); val(p_c, 0); val(u, 0); val(b1.m, 0); val(pump.m, 0);
setCommandLineOptions("-d=-hgtDump"); getErrorString();
r := simulate(HGTNetwork.System, stopTime = 0, simflags = "-override=m_set=8"); getErrorString();

