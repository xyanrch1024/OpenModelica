// name:      HGTLevel1
// keywords:  tearing, hand guided tearing
// status:    correct
//
// Nested hand guided tearing (level 2) of the OCT User's Guide example, and a
// model with states gives a warning.
//

loadFile("HGT.mo"); getErrorString();
setCommandLineOptions("--handGuidedTearing -d=hgtDump,tearingdump"); getErrorString();
simulate(HGT.NonConvex, stopTime = 0); getErrorString();
val(x1, 0.0); val(x2, 0.0);
setCommandLineOptions("-d=-tearingdump"); getErrorString();
simulate(HGT.WithStates); getErrorString();
val(x, 1.0); val(z, 1.0);

